{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@mbarnett/opencode-dcp",
    "version": "4.0.0",
    "type": "module",
    "workspaces": [
        "tests/logger"
    ],
    "description": "OpenCode plugin that optimizes token usage by pruning obsolete tool outputs from conversation context",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tui": {
            "types": "./dist/tui.d.ts",
            "import": "./dist/tui.js"
        }
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "npm run clean && tsup && tsc --emitDeclarationOnly",
        "verify:package": "node scripts/verify-package.mjs",
        "check:package": "npm run build && npm run verify:package",
        "prepublishOnly": "npm run check:package",
        "dev": "opencode plugin dev",
        "sandbox": "node scripts/sandbox.mjs",
        "typecheck": "tsc --noEmit && npm run typecheck --workspace=tests/logger",
        "test": "node --import tsx --test tests/*.test.ts tests/native/*.test.ts && npm test --workspace=tests/logger",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "dcp": "tsx scripts/print.ts"
    },
    "keywords": [
        "opencode",
        "opencode-plugin",
        "plugin",
        "context",
        "pruning",
        "optimization",
        "tokens"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mathewbarnett/opencode-dynamic-context-pruning.git"
    },
    "bugs": {
        "url": "https://github.com/mathewbarnett/opencode-dynamic-context-pruning/issues"
    },
    "homepage": "https://github.com/mathewbarnett/opencode-dynamic-context-pruning#readme",
    "author": "mbarnett",
    "license": "AGPL-3.0-or-later",
    "dependencies": {
        "@anthropic-ai/tokenizer": "^0.0.4",
        "@opentui/core": "^0.9.3",
        "@opentui/solid": "^0.9.3",
        "jsonc-parser": "^3.3.1",
        "solid-js": "^1.9.12",
        "zod": "^4.1.8"
    },
    "devDependencies": {
        "@opencode/ai": "^2.3.2",
        "@opencode/plugin": "^2.3.2",
        "@opencode/theme": "^2.3.2",
        "@types/node": "^25.5.0",
        "prettier": "^3.8.1",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    },
    "files": [
        "dist/",
        "dcp.schema.json",
        "dcp.example.jsonc",
        "README.md",
        "CHANGELOG.md",
        "NOTICE",
        "LICENSE"
    ]
}
